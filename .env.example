# 1Password MCP - environment template
# Copy the values into your Claude config's "env" block (or export in your shell).

# 1) Create a service account: sign in at 1password.com -> Developer -> Service accounts
#    -> New service account -> grant "Read" (or "Read/Write") access to your vault
#    -> copy the token ONCE (starts with sva_ or ops_). NEVER paste it into any chat.
OP_SERVICE_ACCOUNT_TOKEN=paste_your_service_account_token_here

# 2) OPTIONAL but recommended: lock this MCP to ONE vault (name or id).
#    The vault you linked is often shown as "All Items" - use your exact vault name.
# OP_VAULT=All Items

# 3) OPTIONAL: enable write tools (create_login, create_note, delete_item).
#    Keep 0 (read-only) unless you really need Claude to mutate the vault.
# OP_MCP_ALLOW_WRITE=0

# 4) OPTIONAL: full path to the op binary if it's not on PATH.
# OP_BIN_PATH=/usr/local/bin/op
# OP_TIMEOUT_MS=60000
